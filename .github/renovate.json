{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "abandonments:recommended",
    ":configMigration",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "labels": [
    "dependencies"
  ],
  "semanticCommits": "enabled",
  "semanticCommitScope": "deps",
  "separateMinorPatch": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "automerge": true,
  "platformAutomerge": false,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "addLabels": [
      "security"
    ],
    "semanticCommitType": "fix",
    "automerge": false
  },
  "customManagers": [
    {
      "description": "Node, pinned in the workflow that lints commit messages.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/commitlint\\.yaml$/"
      ],
      "matchStrings": [
        "node-version: (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    }
  ],
  "packageRules": [
    {
      "description": "Pin every image to its digest, while actions take theirs from the pinGitHubActionDigests preset.",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "Except the pipeline, which no user ever runs.",
      "matchFileNames": [
        ".github/**"
      ],
      "semanticCommitType": "ci"
    },
    {
      "description": "Bundle the digest refreshes that ship, which carry no version to review.",
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "digest"
      ],
      "groupName": "digests"
    },
    {
      "description": "The same for the pipeline, kept apart so each group carries one commit type.",
      "matchFileNames": [
        ".github/**"
      ],
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "digest"
      ],
      "groupName": "workflow digests"
    },
    {
      "description": "A digest names a build, not a release, so it has no date an age check could measure.",
      "matchUpdateTypes": [
        "digest"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Label major updates and leave them open, so they get a deliberate review.",
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "breaking"
      ],
      "automerge": false
    },
    {
      "description": "Renovate updates itself through the renovate-version line, which the github-actions manager reads as an image but which takes no digest.",
      "matchPackageNames": [
        "ghcr.io/renovatebot/renovate"
      ],
      "pinDigests": false
    }
  ]
}
